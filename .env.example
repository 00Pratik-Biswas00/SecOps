# ============================================================
# Enterprise Security Findings Connector — Environment Config
# Copy this file to .env and fill in your values.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Local development (Docker Compose)
DATABASE_URL=postgresql+asyncpg://connector:connector_pass@localhost:5432/secops_db
DATABASE_URL_SYNC=postgresql+psycopg2://connector:connector_pass@localhost:5432/secops_db

# Cloud Run: set CLOUD_SQL_CONNECTION_NAME and DB_PASSWORD instead.
# DATABASE_URL is then built automatically from the Cloud SQL socket.
# CLOUD_SQL_CONNECTION_NAME=your-project:us-central1:security-connector-db
# DB_PASSWORD=your-strong-db-password

# ── JWT ──────────────────────────────────────────────────────
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
# On Cloud Run: inject via Secret Manager (connector-jwt-secret)
JWT_SECRET_KEY=change-this-to-a-strong-secret-in-production
JWT_EXPIRY_MINUTES=60

# ── User Access Control ───────────────────────────────────────
# Map email addresses to roles. Format: email:ROLE,email:ROLE
# Roles: VIEWER | SECURITY_ENGINEER | SECURITY_ADMIN
#
# VIEWER            — read findings, view audit history
# SECURITY_ENGINEER — read + update findings
# SECURITY_ADMIN    — read + update + full oversight
#
# Add your own email here to sign in:
# On Cloud Run: inject via Secret Manager (connector-user-role-map)
USER_ROLE_MAP=your.name@company.com:SECURITY_ENGINEER,manager@company.com:SECURITY_ADMIN,readonly@company.com:VIEWER

# ── Application ──────────────────────────────────────────────
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Comma-separated allowed CORS origins. Use "*" only for local dev.
# Example: https://your-gemini-app.run.app,https://adk.googleapis.com
CORS_ALLOWED_ORIGINS=*

# ── Gemini ───────────────────────────────────────────────────
# Local dev: use GEMINI_API_KEY directly
# Cloud Run / production: leave GEMINI_API_KEY blank — model access
#   goes through Vertex AI using GCP_PROJECT_ID instead.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ── GCP (Cloud Run / Vertex AI) ──────────────────────────────
# Set these when deploying to Cloud Run — do not set GEMINI_API_KEY alongside GCP_PROJECT_ID.
# ADK uses Workload Identity automatically when GCP_PROJECT_ID is present.
#
# GCP_PROJECT_ID=your-gcp-project-id
# CLOUD_SQL_CONNECTION_NAME=your-project:us-central1:security-connector-db
# DB_PASSWORD=your-strong-db-password
#
# CONNECTOR_URL is used by gemini_agent.py to connect via Streamable HTTP
# instead of stdio — set this to your Cloud Run service URL after deployment.
# Add this to your local .env after gcloud run deploy gives you the URL:
# CONNECTOR_URL=https://enterprise-security-connector-xxx-uc.a.run.app
